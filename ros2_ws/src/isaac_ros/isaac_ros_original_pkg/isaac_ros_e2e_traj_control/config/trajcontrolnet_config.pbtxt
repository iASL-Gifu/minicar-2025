# config.pbtxt for trajcontrolnet

name: "trajcontrolnet"
platform: "tensorrt_plan"
max_batch_size: 1

# --- 入力 ---

input [
  {
    # (1) 画像入力
    name: "input_image" 
    data_type: TYPE_FP32
    # [C, H, W] (config/train.yaml と一致)
    dims: [ 3, 120, 160 ] 
  },
  {
    # (2) 過去オドメトリ入力
    name: "input_odoms" 
    data_type: TYPE_FP32
    # [past_len, odom_features] (config/train.yaml と一致)
    dims: [ 10, 8 ] 
  }
]

# --- 出力 ---
output [
  {
    # (1) 予測軌道 (TrajFormer と同一)
    name: "output_trajectory" 
    data_type: TYPE_FP32
    # [future_len, 3] (config/train.yaml の future_len=10, (x,y,vx)=3)
    dims: [ 30, 3 ] 
  },
  {
    # (2) 【新規】予測コマンド
    name: "output_commands" 
    data_type: TYPE_FP32
    # [future_len, 2] (config/train.yaml の future_len=10, (steer,speed)=2)
    dims: [ 30, 2 ] 
  }
]