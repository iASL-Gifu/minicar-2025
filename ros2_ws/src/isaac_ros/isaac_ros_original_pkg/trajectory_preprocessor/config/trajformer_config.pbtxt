# config.pbtxt for TrajFormerNano

name: "TrajFormerNano"
platform: "tensorrt_plan"
max_batch_size: 1

# --- 入力 ---
# (MergeSyncNodeから渡されるテンソルと一致させる)

input [
  {
    # (1) 画像入力 (dnn_image_encoder -> MergeSyncNode -> Triton)
    # MergeSyncNodeの 'image_tensor_name_in_model' と一致させる
    name: "input_image" 
    data_type: TYPE_FP32
    # [C, H, W] (Launchファイルの network_image_height/width と一致)
    dims: [ 3, 120, 160 ] 
  },
  {
    # (2) 過去オドメトリ入力 (Odom -> MergeSyncNode -> Triton)
    # MergeSyncNodeの 'odom_tensor_name_in_model' と一致させる
    name: "input_odoms" 
    data_type: TYPE_FP32
    # [history_len, odom_features] 
    # (MergeSyncNodeの past_len, odom_dim と一致)
    dims: [ 5, 8 ] 
  }
]

# --- 出力 ---
# (このTritonNodeからDecoderノード等へ渡されるテンソル)

output [
  {
    # ONNXエクスポート時に指定した出力名
    name: "output_trajectory" 
    data_type: TYPE_FP32
    # [future_len, 3] (モデルの future_len=10, 出力次元=3)
    dims: [ 10, 3 ] 
  }
]