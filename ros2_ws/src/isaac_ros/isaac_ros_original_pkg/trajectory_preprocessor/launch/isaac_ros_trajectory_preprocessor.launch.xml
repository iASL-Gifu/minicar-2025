<?xml version="1.0"?>
<launch>    
    <arg name="params_file" default="$(find-pkg-share trajectory_preprocessor)/config/merge_sync_node.yaml" />
    <arg name="container_name" default="localization_container" />

    <arg name="model_repository_path" default="/workspaces/isaac_ros_assets/models/" />
    <arg name="model_name" default="TrajFormer" />

    <arg name="input_image_topic" default="/realsense2_camera/color/image_raw" />
    <arg name="input_camera_info_topic" default="/realsense2_camera/color/camera_info" />
    <arg name="odom_topic" default="/visual_slam/tracking/odometry" />

    <arg name="image_tensor_topic" default="/encoder/tensor_pub" />
    <arg name="merged_tensor_topic" default="/merged_tensor_to_triton" />
    <arg name="triton_output_topic" default="/triton/trajectory_output" />

    <arg name="encoder_output_tensor_name" default="input_1" />
    
    <arg name="triton_input_tensor_names" default="['input_image', 'input_odoms']" />
    <arg name="triton_output_tensor_names" default="['output_trajectory']" />

    <arg name="network_image_width" default="160" />
    <arg name="network_image_height" default="120" />
    <arg name="original_image_width" default="640" />
    <arg name="original_image_height" default="480" />

    <include file="$(find-pkg-share isaac_ros_dnn_image_encoder)/launch/dnn_image_encoder.launch.py">
        <arg name="input_image_width" value="$(var original_image_width)" />
        <arg name="input_image_height" value="$(var original_image_height)" />
        <arg name="network_image_width" value="$(var network_image_width)" />
        <arg name="network_image_height" value="$(var network_image_height)" />
        <arg name="image_input_topic" value="$(var input_image_topic)" />
        <arg name="camera_info_input_topic" value="$(var input_camera_info_topic)" />
        <arg name="tensor_output_topic" value="$(var image_tensor_topic)" />
        <arg name="image_mean" value="[0.5, 0.5, 0.5]" />
        <arg name="image_stddev" value="[0.5, 0.5, 0.5]" />
        <arg name="enable_padding" value="False" />
        <arg name="final_tensor_name" value="$(var encoder_output_tensor_name)" />
        <arg name="attach_to_shared_component_container" value="True" />
        <arg name="component_container_name" value="$(var container_name)" />
        <arg name="dnn_image_encoder_namespace" value="pilotnet_encoder" />
    </include>

    <load_composable_node target="$(var container_name)">
        <composable_node
            pkg="trajectory_preprocessor"
            plugin="trajectory_preprocessor::MergeSyncNode"
            name="merge_sync_node">
            
            <param from="$(var params_file)" />
            
            <remap from="tensor" to="$(var image_tensor_topic)" />
            <remap from="odom" to="$(var odom_topic)" />
            <remap from="tensor_pub" to="$(var merged_tensor_topic)" />
            
        </composable_node>
    </load_composable_node>

    <load_composable_node target="$(var container_name)">
        <composable_node
            pkg="isaac_ros_triton"
            plugin="nvidia::isaac_ros::dnn_inference::TritonNode"
            name="triton_trajformer_node">
            
            <param name="model_name" value="$(var model_name)" />
            <param name="model_repository_paths" value="['$(var model_repository_path)']" />
            
            <param name="input_tensor_names" value="$(var triton_input_tensor_names)" />
            <param name="output_tensor_names" value="$(var triton_output_tensor_names)" />

            <param name="input_binding_names" value="['input_image', 'input_odoms']" />
            <param name="output_binding_names" value="['output_trajectory']" />
            
            <param name="input_tensor_formats" value="['nitros_tensor_list_nchw_rgb_f32', 'nitros_tensor_list_nhwc_rgb_f32']" />
            <param name="output_tensor_formats" value="['nitros_tensor_list_nhwc_rgb_f32']" />

            <remap from="tensor_sub" to="$(var merged_tensor_topic)" />
            <remap from="tensor_pub" to="$(var triton_output_topic)" />
        </composable_node>
    </load_composable_node>

</launch>