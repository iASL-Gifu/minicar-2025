<?xml version="1.0"?>
<launch>
    <arg name="instance_name" />
    
    <arg name="node_suffix" default="_$(var instance_name)" />
    <arg name="topic_suffix" default="_$(var instance_name)" />

    <arg name="container_name" />
    <arg name="model_repository_path" />
    <arg name="triton_input_tensor_names" />
    <arg name="triton_output_tensor_names" />
    <arg name="decoder_input_tensor_name" />
    <arg name="encoder_output_topic" />

    <arg name="model_name" />


    <load_composable_node target="$(var container_name)">
        <composable_node
            pkg="isaac_ros_triton"
            plugin="nvidia::isaac_ros::dnn_inference::TritonNode"
            name="triton_pilotnet_node$(var node_suffix)">
            
            <param name="model_name" value="$(var model_name)" />
            <param name="model_repository_paths" value="['$(var model_repository_path)']" />
            
            <param name="input_tensor_names" value="$(var triton_input_tensor_names)" />
            <param name="output_tensor_names" value="$(var triton_output_tensor_names)" />

            <param name="input_binding_names" value="['input_1']" />
            <param name="output_binding_names" value="['output_1']" />
            
            <param name="input_tensor_formats" value="['nitros_tensor_list_nchw_rgb_f32']" />
            <param name="output_tensor_formats" value="['nitros_tensor_list_nhwc_rgb_f32']" />

            <remap from="tensor_pub" to="$(var encoder_output_topic)" />
            <remap from="tensor_sub" to="/pilot_net$(var topic_suffix)/inference_result" />
        </composable_node>
    </load_composable_node>

    <load_composable_node target="$(var container_name)">
        <composable_node
            pkg="isaac_ros_e2e_pilot"
            plugin="nvidia::isaac_ros::pilot_net::PilotNetDecoderNode"
            name="pilot_net_decoder_node$(var node_suffix)">
            
            <param from="$(find-pkg-share isaac_ros_e2e_pilot)/config/params.yaml" />
            <param name="tensor_name" value="$(var decoder_input_tensor_name)" />

            <remap from="/tensor_out" to="/pilot_net$(var topic_suffix)/inference_result" />
            <remap from="cmd_ackermann" to="/ackermann_cmd$(var topic_suffix)" />
        </composable_node>
    </load_composable_node>

</launch>