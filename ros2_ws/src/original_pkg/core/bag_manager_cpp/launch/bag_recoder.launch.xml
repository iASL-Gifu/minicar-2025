<launch>

  <arg name="input_trigger_topic" default="/rosbag2_recorder/trigger"/>
  <arg name="bag_recorder_param"  default="$(find-pkg-share bag_manager_cpp)/config/bag_recorder.param.yaml"/>
  <!-- bag_manager node -->
  <node pkg="bag_manager_cpp" 
        exec="bag_recorder_node"
        name="bag_recorder_node"
        output="screen">

    <!-- パラメータ -->
    <param from="$(var bag_recorder_param)"/>
    <!-- トピックのremap -->
    <remap from="/rosbag2_recorder/trigger" to="$(var input_trigger_topic)"/>
  </node>


</launch>